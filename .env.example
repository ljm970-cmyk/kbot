# ============================================================
# kbot 환경설정
#
#   cp .env.example .env
#   chmod 600 .env
#
# 이 파일은 절대 커밋하지 않는다 (.gitignore 확인).
# ============================================================

# --- 키움증권 REST API (필수) ---------------------------------
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 모의투자 서버 사용 (mockapi.kiwoom.com)
# 실계좌 전에 배관 확인용으로 쓴다.
KIWOOM_MOCK=false

# --- 텔레그램 (필수) ------------------------------------------
TELEGRAM_BOT_TOKEN=
# 관리자 텔레그램 숫자 ID. 쉼표로 여러 명 지정 가능.
# 비워두면 기동을 거부한다 (누구나 주문을 낼 수 있게 되므로).
TELEGRAM_ADMIN_ID=

# --- 운영 모드 ------------------------------------------------
# true 면 주문 계획만 세우고 전송하지 않는다.
# 첫 며칠은 이 모드로 관찰할 것.
KBOT_DRY_RUN=false

# --- 기본값 (종목별 설정에서 덮어쓸 수 있다) --------------------
DEFAULT_DIVISION=40
DEFAULT_PRINCIPAL=20000
# 거래 수수료율. 0.0007 == 0.07%. 증권사 고지 기준으로 입력.
DEFAULT_FEE_RATE=0.0007
# 최소 수수료(USD). 계좌 조건에 따라 없을 수도 있다.
DEFAULT_MIN_FEE=0

# --- 경로 (기본값은 프로젝트 루트 기준) ------------------------
# KBOT_HOME=/home/ljm970/kbot
# KBOT_DATA_DIR=/home/ljm970/kbot/data
# KBOT_LOG_DIR=/home/ljm970/kbot/logs
# KBOT_ENV_FILE=/home/ljm970/kbot/.env
