# ==========================================
# 1. 키움증권 REST API 인증
# ==========================================

KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here
KIWOOM_ACCESS_TOKEN=

# ==========================================
# 2. 텔레그램 알림
# ==========================================

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=

# ==========================================
# 3. 기본 설정
# ==========================================

PRINCIPAL_USD=20000
DIVISION=40
STOCK_CODE=TQQQ
STOCK_TYPE=TQQQ
COMPOUND_MODE=compound

# ==========================================
# 4. 수수료 (키움 계좌별 상이)
# ==========================================

FEE_PER_SHARE=0.00555
MIN_TRADE_FEE=2.95
FEE_MODE=per_share
MAX_FEE_PCT=0.01

# ==========================================
# 5. 데이터베이스
# ==========================================

DATABASE_URL=sqlite:///./data/infinite_buy.db

# ==========================================
# 6. 고급 설정
# ==========================================

LOG_LEVEL=INFO
