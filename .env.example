# ==================================
# 키움증권 REST API 설정
# ==================================

# 운영 서버 (실전 거래)
PRD=https://api.kiwoom.com

# 모의투자 서버
MOCK=https://mockapi.kiwoom.com

# 운영 WebSocket
W_PRD=wss://api.kiwoom.com:10000

# 모의투자 WebSocket  
W_MOCK=wss://mockapi.kiwoom.com:10000

# ==================================
# 인증 모드: real (실전), demo/mock (모의투자)
# ==================================
KIWOOM_MODE=real

# ==================================
# 실전 운영용 APP_KEY, APP_SECRET
# https://openapi.kiwoom.com 에서 발급
# ==================================
APP_KEY=실제_발급받은_app_key_입력
APP_SECRET=실제_발급받은_app_secret_입력

# ==================================
# 모의투자용 APP_KEY, APP_SECRET  
# ==================================
APP_KEY_MOCK=모의투자_app_key_입력
APP_SECRET_MOCK=모의투자_app_secret_입력

# ==================================
# 텔레그램 알림 설정 (v4.0 기능)
# ==================================
TELEGRAM_BOT_TOKEN=봇아빠가_주신_토큰_입력
TELEGRAM_CHAT_ID=본인_채팅_ID_입력

# ==================================
# v4.0 자동매매 설정
# ==================================
V4_TICKER=TQQQ
V4_PRINCIPAL=20000
V4_SPLITS=20
V4_COMPOUND=1.0
V4_FEE=0.025
