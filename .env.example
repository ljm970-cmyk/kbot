# ==================================
# 키움증권 REST API 설정
# ==================================

# 모드: real (실전), mock (모의투자)
KIWOOM_MODE=real

# 서버 주소 (공식 문서 기준: api.kiwoom.com, openapi 아님!)
PRD=https://api.kiwoom.com
MOCK=https://mockapi.kiwoom.com

# WebSocket (실시간 시세용)
W_PRD=wss://api.kiwoom.com:10000
W_MOCK=wss://mockapi.kiwoom.com:10000

# ==================================
# 실전용 API 키 (https://openapi.kiwoom.com 포털에서 발급)
# ==================================
APP_KEY=실제_발급받은_app_key_입력
APP_SECRET=실제_발급받은_app_secret_입력

# ==================================
# 모의투자용 API 키
# ==================================
APP_KEY_MOCK=모의_app_key_입력
APP_SECRET_MOCK=모의_app_secret_입력

# ==================================
# 텔레그램 알림 설정 (필수)
# ==================================
TELEGRAM_BOT_TOKEN=봇아빠가_주신_토큰_입력
TELEGRAM_CHAT_ID=본인_채팅_ID_입력

# ==================================
# v4.0 자동매매 설정
# ==================================
V4_TICKER=TQQQ
V4_PRINCIPAL=20000
V4_SPLITS=20
V4_COMPOUND=1.0
V4_FEE=0.025
