# .env.example - 무한매수법 V4.0 환경변수 템플릿
# 복사하여 .env로 저장 후 실제 값 입력
# .env는 Git에 절대 커밋하지 마세요

# ==========================================
# 1. 키움증권 REST API 인증
# ==========================================

# 키움증권 OPEN API+ 또는 모바일 앱에서 발급
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here
KIWOOM_ACCESS_TOKEN=  # 비워두면 자동 발급

# ==========================================
# 2. 텔레그램 알림 (BotFather @BotFather)
# ==========================================

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_CHAT_ID=your_main_chat_id
TELEGRAM_ADMIN_CHAT_ID=  # 긴급 알림용 (선택)

# ==========================================
# 3. 기본 설정
# ==========================================

# 원금 USD (예: 20000)
PRINCIPAL_USD=20000

# 분할수: 20(공격적) / 40(보수적, 권장)
DIVISION=40

# 운용 종목: TQQQ 또는 SOXL
STOCK_CODE=TQQQ
STOCK_TYPE=TQQQ

# 수익금 처리 방식: compound(복리) / simple(단리)
COMPOUND_MODE=compound

# ==========================================
# 4. 주문 설정
# ==========================================

# 첫매수 큰수 % (고정 15%): 1.15 = 종가의 115%
FIRST_BUY_PREMIUM_PCT=0.15

# LOC 거부 시 재시도 % (고정 15%): 현재가의 115%
CONDITIONAL_RETRY_PREMIUM_PCT=0.15

# ==========================================
# 5. 수수료 (키움 계좌별 상이)
# ==========================================

# 주당 수수료 ($)
FEE_PER_SHARE=0.00555

# 최소 거래 수수료 ($)
MIN_TRADE_FEE=2.95

# 수수료 모드: per_share / flat / percentage
FEE_MODE=per_share

# ==========================================
# 6. 데이터베이스
# ==========================================

# SQLite 파일 경로
DATABASE_URL=sqlite:///./data/infinite_buy.db

# ==========================================
# 7. 중계/모니터링 설정 (선택)
# ==========================================

# 추적유형: 1(시장가/시장지정가), 2(일반지정가)
TRACKING_TP=2

# 모의투자/실전 구분: Y(미지정주문/테스트) / N(실전)
MOCK_INDICATOR=N

# ==========================================
# 8. 고급 설정
# ==========================================

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
