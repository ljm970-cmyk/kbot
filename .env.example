# ==================================
# 키움증권 REST API 설정
# ==================================

# 모드: real (실전), mock (모의투자)
KIWOOM_MODE=real

# 서버 주소
PRD=https://openapi.kiwoom.com
MOCK=https://mockapi.kiwoom.com

# 실전용 API 키 (openapi.kiwoom.com 에서 발급)
APP_KEY=PsxEsdcre8dca.....
APP_SECRET=WsEfdcwcfore9Dre2fdvc.....

# 모의투자용 API 키
APP_KEY_MOCK=모의_app_key_입력
APP_SECRET_MOCK=모의_app_secret_입력

# ==================================
# 텔레그램 알림 설정 (필수)
# ==================================
TELEGRAM_BOT_TOKEN=123456789:ABCDEFgHiJkLmNoPqRsTuVwXyZ   # @BotFather에서 발급
TELEGRAM_CHAT_ID=123456789                                  # @userinfobot에서 확인

# ==================================
# v4.0 자동매매 설정
# ==================================
V4_TICKER=TQQQ
V4_PRINCIPAL=20000
V4_SPLITS=20
V4_COMPOUND=1.0
V4_FEE=0.025
