# ============================================================
# kbot 환경 설정 템플릿
# ============================================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# .env는 .gitignore에 의해 Git 추적 제외됩니다.
# VM 인스턴스에 직접 배포: scp .env user@vm:/opt/kbot/.env
# ============================================================

# ------------------------------------------------------------
# 키움증권 REST API (운영 전용, 모의투자 미사용)
# ------------------------------------------------------------

# 운영 API base URL (고정)
KIWOOM_API_BASE=https://api.kiwoom.com

# 운영 WebSocket URL (고정)
KIWOOM_WS_URL=wss://api.kiwoom.com:10000

# 키움 OpenAPI 앱 키 (키움증권 개발자센터에서 발급)
KIWOOM_APP_KEY=your_app_key_here

# 키움 OpenAPI 시크릿 (키움증권 개발자센터에서 발급)
KIWOOM_APP_SECRET=your_app_secret_here

# 인증 모드 (고정: real, 모의투자 사용 안함)
KIWOOM_MODE=real


# ------------------------------------------------------------
# 텔레그램 봇 (@BotFather에서 발급)
# ------------------------------------------------------------

# 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 관리자 텔레그램 사용자 ID (숫자, @userinfobot에서 확인)
TELEGRAM_ADMIN_ID=your_telegram_numeric_id


# ------------------------------------------------------------
# Google Cloud (선택, 백업용)
# ------------------------------------------------------------

# Cloud Storage 버킷 이름 (없으면 백업 비활성화)
GCS_BUCKET_NAME=

# GCP 프로젝트 ID
GCP_PROJECT_ID=


# ------------------------------------------------------------
# kbot 기본값 (선택, 미입력 시 코드 내 기본값 사용)
# ------------------------------------------------------------

# 기본 분할 수 (20 또는 40)
DEFAULT_DIVISION=40

# 기본 원금 (달러)
DEFAULT_PRINCIPAL=20000

# 기본 수수료율 (0.0007 = 0.07%)
DEFAULT_FEE_RATE=0.0007


# ------------------------------------------------------------
# 시스템 (선택)
# ------------------------------------------------------------

# 타임존 (고정)
TZ=Asia/Seoul
