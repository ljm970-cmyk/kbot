[Unit]
Description=kbot 무한매수법 자동매매 (DRY RUN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ljm970
Group=ljm970
WorkingDirectory=/home/ljm970/kbot

Environment=PYTHONPATH=/home/ljm970/kbot
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Seoul
# 주문 미전송. 실운영 전까지 절대 지우지 말 것.
Environment=KBOT_DRY_RUN=true

ExecStart=/home/ljm970/kbot/venv/bin/python /home/ljm970/kbot/main.py

KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ljm970/kbot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kbot

[Install]
WantedBy=multi-user.target
